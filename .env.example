# Ruta absoluta al JSON de una cuenta de servicio de Google.
# Nunca confirmes este archivo ni el JSON de credenciales en Git.
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\privada\service-account.json

# ID de la hoja privada (el valor entre /d/ y /edit en la URL).
FINANCE_SPREADSHEET_ID=reemplazar

# Copia config/accounts.example.json a este archivo y completa los últimos
# cuatro dígitos localmente. El archivo local está ignorado por Git.
FINANCE_ACCOUNTS_CONFIG=config/accounts.local.json

# Opcional: reglas privadas que complementan config/rules.json.
FINANCE_PRIVATE_RULES_CONFIG=config/rules.local.json
